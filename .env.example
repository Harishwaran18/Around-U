# Copy this file to .env and fill in the values.
# Flask reads it automatically through python-dotenv when present.

# Long random string used to sign session cookies. Required in production.
SECRET_KEY=change-me-to-a-long-random-string

# Leave blank to use the bundled SQLite database (aroundu.db).
# In production use a PostgreSQL URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/aroundu
DATABASE_URL=

# Set to 1 when the app is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Create missing tables on boot. Keep enabled for the simplest setup.
AUTO_CREATE_TABLES=1

# Seed demo data automatically when the database is empty.
SEED_ON_STARTUP=0

FLASK_APP=app
FLASK_DEBUG=1
